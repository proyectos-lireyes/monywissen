        "phone": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "alias"]
    },
    "backups": {
      "title": "Backups",
      "description": "Full application state backups per user",
      "type": "object",
      "properties": {
        "userEmail": { "type": "string" },
        "dataPayload": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userEmail"]
    }
  }
}
